POSTGRES_USER=dbuser
POSTGRES_PASSWORD=choose-a-password-here
POSTGRES_DB=dbname
# Optional for the backend (defaults shown):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Signs login tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
# Optional (defaults shown):
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# COOKIE_SECURE=false   (set true in production, where the site runs on HTTPS)
